{
  "source": {
    "provider": "fixture",
    "endpoint": "/fixture/daily-closes/{date}",
    "market": "us-stocks",
    "universe": "fixture-ordered-universe",
    "adjustment": "unadjusted",
    "interval": "1d"
  },
  "data_root": "data",
  "database_config": "dbinfo.id",
  "features": {
    "ticker_ids": [17, 3],
    "lookback_sessions": 1,
    "signal_mode": "previous_close",
    "interval": "1d",
    "missing_history": "unavailable",
    "feature_order": ["close_over_first_window_close_minus_one"],
    "adjustment": "adjusted"
  },
  "model": {
    "architecture": "mlp",
    "hidden_widths": [],
    "activation": "leaky_relu",
    "layer_types": ["linear"],
    "bias": "all",
    "layer_normalization": true,
    "final_activation": "none",
    "implementation_version": "stockguidance-models-v1"
  },
  "training": {
    "epochs": 1,
    "batch_size": 1,
    "learning_rate": 0.01,
    "learning_rate_gamma": 1.0,
    "optimizer": "adamw",
    "device": "cpu",
    "precision": "fp32",
    "seed": 17,
    "shuffle": false,
    "num_workers": 0,
    "pin_memory": false
  },
  "start_date": "2020-07-02",
  "end_date": "2026-07-03",
  "training_cutoff": "2024-07-06T21:00:00+00:00",
  "availability_policy": "strict",
  "data_snapshot": null,
  "publication_delay_minutes": 15,
  "publication_evidence": "",
  "decision_minutes_before_close": 30,
  "evaluation": null
}
